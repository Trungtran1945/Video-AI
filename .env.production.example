# Production environment contract (fail-fast, no defaults).
# Copy to .env (never commit .env) and fill with strong random values.
# Sinh secret ≥32 ký tự (chạy 3 lần, mỗi biến 1 giá trị — KHÔNG dùng placeholder):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Required (≥32 chars, never dev defaults, never empty, never placeholder):
JWT_ACCESS_SECRET=replace-with-64-hex-chars-min-32
JWT_REFRESH_SECRET=replace-with-64-hex-chars-min-32
MASTER_KEY=replace-with-64-hex-chars-min-32
#
# CORS production (fail-closed when empty — set your frontend origin):
# Comma-separated, e.g. https://app.example.com
# Same-origin qua nginx :80 (khuyên dùng) không cần set; gọi trực tiếp :3001
# hoặc domain khác thì bắt buộc set khớp Origin (scheme+host+port).
# Ví dụ HTTP LAN: CORS_ORIGINS=http://192.168.1.10
CORS_ORIGINS=https://app.example.com
#
# Refresh cookie: Secure ở production (mặc định true). HTTP LAN nội bộ
# (http://<LAN-IP>) không có TLS → browser drop cookie Secure → login loop.
# Fix: COOKIE_SECURE=false khi còn HTTP nội bộ; prod public http là downgrade
# bảo mật — chỉ tắt cho LAN nội bộ, hoặc terminate TLS rồi giữ true.
COOKIE_SECURE=true
#
# Admin bootstrap production (khớp resolveAdminSeed trong backend/src/db/seed.js):
# rỗng = skip + warn (vẫn boot), <12 ký tự = fail-fast throw:
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password-min-12
#
# Redis (internal Docker network; no public port by default):
REDIS_HOST=redis
REDIS_PORT=6379
#
# Whisper ASR (effective semantics are part of ASR cache identity):
# Changing MODEL/TEMPERATURE/PROMPT/ENDPOINT busts stale cache (miss, never stale hit).
WHISPER_BASE_URL=https://api.openai.com/v1
WHISPER_MODEL=whisper-1
WHISPER_TEMPERATURE=0
WHISPER_INITIAL_PROMPT=
# Groq free-tier compatible (set GROQ_API_KEY or WHISPER_API_KEY):
WHISPER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
#
# Other providers / ops (see backend/.env.example for full list):
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
#
# SMTP notification (compose: api NOTIFY_FROM_EMAIL; rỗng = tắt gửi mail):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_FROM_EMAIL=noreply@example.com
#
# Storage & DB (compose mount volumes; sql.js bắt buộc INSTANCE_MODE=single):
STORAGE_DIR=/app/storage
DATABASE_URL=file:/app/data/data.db
DB_PATH=/app/data/data.db
INSTANCE_MODE=single
PORT=3001
NODE_ENV=production
#
# ZeroTTS local inference (compose service zerotts; api gọi qua ZEROTTS_URL):
ZEROTTS_URL=http://zerotts:5005
ZEROTTS_MODEL=zeroweight-ai/ZeroTTS
ZEROTTS_VOICE=maichi
ZEROTTS_THREADS=4
ZEROTTS_CONCURRENCY=1
ZEROTTS_MAX_INFLIGHT_REQUESTS=8
ZEROTTS_MAX_BODY_BYTES=65536
ZEROTTS_MAX_TEXT_CHARS=2000
ZEROTTS_OUTPUT_ROOT=/tmp/zerotts_service
ZEROTTS_TIMEOUT_MS=60000
ZEROTTS_SHUTDOWN_TIMEOUT_MS=15000
#
# Ops tuning (khớp compose defaults + backend/src/config.js):
QUOTA_WARNING_THRESHOLD=0.8
MAX_CONCURRENT_PROJECTS_PER_USER=2
PROJECT_RETENTION_DAYS=30
PROJECT_LEASE_SECONDS=1800
UPLOAD_SESSION_TTL_MINUTES=60
DB_MAX_PENDING_WRITES=1000
DB_SLOW_WRITE_MS=1000
