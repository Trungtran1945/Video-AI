# Production environment contract (fail-fast, no defaults).
# Copy to .env (never commit .env) and fill with strong random values:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Required (≥32 chars, never dev defaults, never empty):
JWT_ACCESS_SECRET=replace-with-64-hex-chars-min-32
JWT_REFRESH_SECRET=replace-with-64-hex-chars-min-32
MASTER_KEY=replace-with-64-hex-chars-min-32
#
# CORS production (fail-closed when empty — set your frontend origin):
# Comma-separated, e.g. https://app.example.com
CORS_ORIGINS=https://app.example.com
#
# Redis (internal Docker network; no public port by default):
REDIS_HOST=redis
REDIS_PORT=6379
#
# Whisper ASR (effective semantics are part of ASR cache identity):
# Changing MODEL/TEMPERATURE/PROMPT/ENDPOINT busts stale cache (miss, never stale hit).
WHISPER_BASE_URL=https://api.openai.com/v1
WHISPER_MODEL=whisper-1
WHISPER_TEMPERATURE=0
WHISPER_INITIAL_PROMPT=
# Groq free-tier compatible (set GROQ_API_KEY or WHISPER_API_KEY):
WHISPER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
#
# Other providers / ops (see backend/.env.example for full list):
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
