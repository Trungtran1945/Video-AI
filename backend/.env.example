# ── Rate Limiting / Free Tier (docs/11) ──
PROVIDER_RATE_LIMIT_SAFETY_MARGIN=0.8
PROVIDER_CACHE_ENABLED=true
PROVIDER_CACHE_TTL_DAYS=90
QUOTA_WARNING_THRESHOLD=0.8
DEFAULT_PROVIDER_MODE=live    # 'live' | 'mock'

# ── Whisper ASR (STT-only; effective semantics are part of ASR cache identity) ──
# Changing any of these busts stale cache (miss, never stale hit).
WHISPER_BASE_URL=https://api.openai.com/v1
WHISPER_MODEL=whisper-1
WHISPER_TEMPERATURE=0
WHISPER_INITIAL_PROMPT=
WHISPER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# NOTE: OCR removed (STT-only architecture). Legacy OCR_SAMPLE_FPS / tesseract
# have no runtime consumer and must not be reintroduced. Translation cache
# retains legacy `ocrMode` field only for backward-compat (always STT path).

# ── ZeroTTS Local (Keyless, local CPU inference, zero cloud quota) ──
ZEROTTS_URL=http://127.0.0.1:5005
ZEROTTS_VOICE=maichi
ZEROTTS_MODEL=zeroweight-ai/ZeroTTS
# ZEROTTS_MODEL_DIR=/path/to/local/model (tùy chọn: đường dẫn thư mục model weights trên đĩa)
ZEROTTS_TIMEOUT_MS=60000
# Trần chờ model ZeroTTS ready ở dub.ttsAlign (503 MODEL_NOT_READY); hết trần → failover.
ZEROTTS_READY_WAIT_MS=60000
ZEROTTS_CONCURRENCY=1
ZEROTTS_THREADS=4
# ZEROTTS_OUTPUT_ROOT chỉ dành cho client legacy gửi out_path; backend hiện nhận
# WAV bytes qua HTTP rồi tự ghi/convert MP3, không chia sẻ filesystem với service.

# ── ZeroTTS dev auto-start (`npm run dev` tự kèm service, xem scripts/dev.mjs) ──
# ZEROTTS_ENABLED=true        # công tắc tổng (production luôn coi như false)
# ZEROTTS_AUTO_START=false    # tắt auto-start, chỉ chạy API (tương đương `npm run dev:api-only`)
# ZEROTTS_WAIT_FOR_READY=true # chặn tới khi TTS healthy/timeout (mặc định false: API lên ngay)
# ZEROTTS_STARTUP_TIMEOUT_MS=90000  # trần đợi /health (lần đầu tải ~900MB model có thể >60s)
# ZEROTTS_PYTHON_BIN=         # override binary python (vd C:\Python311\python.exe); trống = tự dò python→py→python3

# ── YouTube publishing (OAuth 2.0 + PKCE) ──
# Tạo OAuth Client (Loại: Web application) tại Google Cloud Console, bật
# "YouTube Data API v3", rồi thêm redirect URI khớp CHÍNH XÁC giá trị bên dưới.
# Dev:  http://localhost:3001/api/v1/youtube/oauth/callback
# Prod: https://<domain>/api/v1/youtube/oauth/callback (nếu API ở prefix khác, sửa tương ứng)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/v1/youtube/oauth/callback
# Nơi callback redirect về sau khi kết nối (mặc định http://localhost:5173)
FRONTEND_URL=http://localhost:5173

